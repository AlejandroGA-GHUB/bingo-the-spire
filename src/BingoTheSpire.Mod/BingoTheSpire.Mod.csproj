<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The mod itself. The game loads mods/<folder>/BingoTheSpire.json + BingoTheSpire.dll, so AssemblyName MUST equal the manifest id.
    Only this project may touch game internals (sts2.dll, Godot, Harmony), and only through the GameAdapter layer.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>BingoTheSpire</AssemblyName>
    <RootNamespace>BingoTheSpire.Mod</RootNamespace>
    <ModId>BingoTheSpire</ModId>
    <!-- Keep in sync with "version" in BingoTheSpire.json. -->
    <!-- One version, kept in the manifest: the DLL reports the same number. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)BingoTheSpire.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Deploy into the game's mods folder after building, when the game is installed. Disable with -p:DeployToGame=false. -->
    <DeployToGame Condition="'$(DeployToGame)' == '' And Exists('$(GameDir)\SlayTheSpire2.exe')">true</DeployToGame>
    <ModDeployDir>$(GameDir)\mods\$(ModId)</ModDeployDir>
  </PropertyGroup>

  <!-- Core is compiled into this assembly rather than shipped as a second DLL. -->
  <ItemGroup>
    <Compile Include="$(RepoRoot)src\BingoTheSpire.Core\**\*.cs"
             Exclude="$(RepoRoot)src\BingoTheSpire.Core\bin\**;$(RepoRoot)src\BingoTheSpire.Core\obj\**"
             Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(RepoRoot)src\BingoTheSpire.Core\Goals\goals.json" LogicalName="BingoTheSpire.goals.json" />
  </ItemGroup>

  <!-- Fonts (SIL OFL) are embedded in the DLL; their licenses ship next to it. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\*.ttf" LogicalName="BingoTheSpire.Fonts.%(Filename)%(Extension)" />
    <None Include="Assets\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Game assemblies: compile-time only, never copied (the game provides them at runtime). -->
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(Sts2RefDir)\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2RefDir)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2RefDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ModId).json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckGameRefs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2RefDir)\sts2.dll')"
           Text="sts2.dll not found in '$(Sts2RefDir)'. Set GameDir (or Sts2RefDir) in local.props. See README." />
  </Target>

  <Target Name="DeployModToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(ModDeployDir)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll;$(TargetDir)$(AssemblyName).pdb;$(TargetDir)$(ModId).json;$(TargetDir)OFL-MochiyPopOne.txt;$(TargetDir)OFL-Mali.txt"
          DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="BingoTheSpire deployed to $(ModDeployDir)" />
  </Target>

</Project>
