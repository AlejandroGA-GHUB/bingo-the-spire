// Bingo the Spire goal list. Format: docs/design-spec.md section 6.1.
// Bump "version" whenever a change would change the boards a seed builds (adding, removing or
// retuning goals, tiers or tags). Never reuse an id for a different goal.
// Difficulty: 1 = happens in most runs, 3 = needs some planning, 5 = rare.
{
  "version": 4,
  "goals": [
    // ---- Cards ----------------------------------------------------------------------------
    { "id": "cards_in_turn", "text": "Play {n}+ cards in a single turn", "detector": "CardsPlayedInTurn", "tags": ["cards-per-turn"],
      "tiers": [ { "difficulty": 1, "params": { "n": 7 } }, { "difficulty": 2, "params": { "n": 9 } }, { "difficulty": 3, "params": { "n": 12 } }, { "difficulty": 4, "params": { "n": 15 } } ] },
    { "id": "attacks_in_turn", "text": "Play {n}+ Attacks in a single turn", "detector": "AttacksPlayedInTurn", "tags": ["attacks"],
      "tiers": [ { "difficulty": 1, "params": { "n": 4 } }, { "difficulty": 2, "params": { "n": 6 } }, { "difficulty": 3, "params": { "n": 8 } }, { "difficulty": 4, "params": { "n": 10 } } ] },
    { "id": "skills_in_turn", "text": "Play {n}+ Skills in a single turn", "detector": "SkillsPlayedInTurn", "tags": ["skills"],
      "tiers": [ { "difficulty": 1, "params": { "n": 4 } }, { "difficulty": 2, "params": { "n": 5 } }, { "difficulty": 3, "params": { "n": 7 } }, { "difficulty": 4, "params": { "n": 9 } } ] },
    { "id": "powers_in_combat", "text": "Play {n}+ Powers in a single fight", "detector": "PowersPlayedInCombat", "tags": ["powers"],
      "tiers": [ { "difficulty": 1, "params": { "n": 2 } }, { "difficulty": 2, "params": { "n": 3 } }, { "difficulty": 3, "params": { "n": 4 } }, { "difficulty": 4, "params": { "n": 6 } } ] },
    { "id": "draw_in_turn", "text": "Draw {n}+ cards in a single turn", "detector": "CardsDrawnInTurn", "tags": ["draw"],
      "tiers": [ { "difficulty": 1, "params": { "n": 8 } }, { "difficulty": 2, "params": { "n": 10 } }, { "difficulty": 3, "params": { "n": 14 } }, { "difficulty": 4, "params": { "n": 20 } } ] },
    { "id": "energy_in_turn", "text": "Spend {n}+ energy in a single turn", "detector": "EnergyInTurn", "tags": ["energy"],
      "tiers": [ { "difficulty": 1, "params": { "n": 5 } }, { "difficulty": 2, "params": { "n": 6 } }, { "difficulty": 3, "params": { "n": 8 } }, { "difficulty": 4, "params": { "n": 10 } } ] },
    { "id": "expensive_card", "text": "Play a card that costs {n}+ energy", "detector": "CardCost", "tags": ["energy"],
      "tiers": [ { "difficulty": 1, "params": { "n": 3 } }, { "difficulty": 3, "params": { "n": 4 } }, { "difficulty": 4, "params": { "n": 5 } } ] },
    { "id": "exhaust_in_combat", "text": "Exhaust {n}+ cards in a single fight", "detector": "CardsExhaustedInCombat", "tags": ["exhaust"],
      "tiers": [ { "difficulty": 1, "params": { "n": 4 } }, { "difficulty": 2, "params": { "n": 6 } }, { "difficulty": 3, "params": { "n": 10 } }, { "difficulty": 4, "params": { "n": 15 } } ] },
    { "id": "shuffles_in_combat", "text": "Shuffle your draw pile {n}+ times in a single fight", "detector": "ShufflesInCombat", "tags": ["shuffle"],
      "tiers": [ { "difficulty": 1, "params": { "n": 2 } }, { "difficulty": 2, "params": { "n": 3 } }, { "difficulty": 3, "params": { "n": 5 } } ] },
    { "id": "generated_in_combat", "text": "Create {n}+ cards in a single fight", "detector": "CardsGeneratedInCombat", "tags": ["generated"],
      "tiers": [ { "difficulty": 1, "params": { "n": 3 } }, { "difficulty": 2, "params": { "n": 5 } }, { "difficulty": 3, "params": { "n": 8 } } ] },

    // ---- Damage and kills -----------------------------------------------------------------
    { "id": "damage_in_turn", "text": "Deal {n}+ damage in a single turn", "detector": "DamageInTurn", "tags": ["damage"],
      "tiers": [ { "difficulty": 1, "params": { "n": 50 } }, { "difficulty": 2, "params": { "n": 80 } }, { "difficulty": 3, "params": { "n": 130 } }, { "difficulty": 4, "params": { "n": 200 } } ] },
    { "id": "big_hit", "text": "Deal {n}+ damage with a single hit", "detector": "BiggestHit", "tags": ["big-hit"],
      "tiers": [ { "difficulty": 1, "params": { "n": 25 } }, { "difficulty": 2, "params": { "n": 40 } }, { "difficulty": 3, "params": { "n": 60 } }, { "difficulty": 4, "params": { "n": 100 } } ] },
    { "id": "overkill", "text": "Overkill an enemy by {n}+", "detector": "Overkill", "tags": ["overkill"],
      "tiers": [ { "difficulty": 1, "params": { "n": 15 } }, { "difficulty": 2, "params": { "n": 30 } }, { "difficulty": 3, "params": { "n": 50 } } ] },
    { "id": "exact_kills", "text": "Land {n} killing blows with exactly 0 overkill", "detector": "ExactKills", "tags": ["overkill"],
      "tiers": [ { "difficulty": 2, "params": { "n": 2 } }, { "difficulty": 3, "params": { "n": 4 } }, { "difficulty": 4, "params": { "n": 6 } } ] },
    { "id": "kills_in_turn", "text": "Kill {n}+ enemies in a single turn", "detector": "KillsInTurn", "tags": ["kills"],
      "tiers": [ { "difficulty": 1, "params": { "n": 2 } }, { "difficulty": 3, "params": { "n": 3 } }, { "difficulty": 4, "params": { "n": 4 } } ] },
    { "id": "card_hits", "text": "Hit {n}+ enemies with a single card", "detector": "CardHits", "tags": ["aoe"],
      "tiers": [ { "difficulty": 2, "params": { "n": 3 } }, { "difficulty": 3, "params": { "n": 4 } }, { "difficulty": 4, "params": { "n": 5 } } ] },

    // ---- Block, HP and fights -------------------------------------------------------------
    { "id": "block_in_turn", "text": "Gain {n}+ Block in a single turn", "detector": "BlockInTurn", "tags": ["block"],
      "tiers": [ { "difficulty": 1, "params": { "n": 25 } }, { "difficulty": 2, "params": { "n": 40 } }, { "difficulty": 3, "params": { "n": 60 } }, { "difficulty": 4, "params": { "n": 90 } } ] },
    { "id": "flawless_elite", "text": "Defeat an elite without losing HP", "detector": "FlawlessElite", "tags": ["flawless", "elites"],
      "tiers": [ { "difficulty": 3 } ] },
    { "id": "flawless_boss", "text": "Defeat a boss without losing HP", "detector": "FlawlessBoss", "tags": ["flawless", "bosses"],
      "tiers": [ { "difficulty": 5 } ] },
    { "id": "flawless_hallways", "text": "Win {n} normal fights without losing HP", "detector": "FlawlessHallways", "tags": ["flawless"],
      "tiers": [ { "difficulty": 1, "params": { "n": 3 } }, { "difficulty": 2, "params": { "n": 6 } }, { "difficulty": 3, "params": { "n": 10 } } ] },
    { "id": "quick_win", "text": "Win a fight by turn {n}", "detector": "QuickWin", "tags": ["speed"],
      "tiers": [ { "difficulty": 1, "params": { "n": 2 } }, { "difficulty": 5, "params": { "n": 1 } } ] },
    { "id": "low_hp_win", "text": "Win a fight with {n} HP or less", "detector": "LowHpWin", "tags": ["low-hp"],
      "tiers": [ { "difficulty": 2, "params": { "n": 10 } }, { "difficulty": 3, "params": { "n": 5 } }, { "difficulty": 4, "params": { "n": 1 } } ] },
    { "id": "survive_hit", "text": "Lose {n}+ HP to a single hit and survive", "detector": "SurviveHit", "tags": ["hit-taken"],
      "tiers": [ { "difficulty": 1, "params": { "n": 10 } }, { "difficulty": 3, "params": { "n": 20 } }, { "difficulty": 4, "params": { "n": 30 } } ] },
    { "id": "elites_defeated", "text": "Defeat {n} elites", "detector": "ElitesDefeated", "tags": ["elites"],
      "tiers": [ { "difficulty": 1, "params": { "n": 2 } }, { "difficulty": 2, "params": { "n": 4 } }, { "difficulty": 3, "params": { "n": 5 } }, { "difficulty": 4, "params": { "n": 7 } } ] },
    { "id": "bosses_defeated", "text": "Defeat {n} bosses", "detector": "BossesDefeated", "tags": ["bosses"], "excludeGameModes": ["Blitz"],
      "tiers": [ { "difficulty": 3, "params": { "n": 2 } }, { "difficulty": 4, "params": { "n": 3 } } ] },

    // ---- Powers ---------------------------------------------------------------------------
    { "id": "debuff_variety", "text": "Have {n}+ of your debuffs on one enemy at once", "detector": "DebuffVariety", "tags": ["debuffs"],
      "tiers": [ { "difficulty": 1, "params": { "n": 2 } }, { "difficulty": 2, "params": { "n": 3 } }, { "difficulty": 3, "params": { "n": 4 } }, { "difficulty": 5, "params": { "n": 5 } } ] },
    { "id": "debuff_stacks", "text": "Put {n}+ stacks of one debuff on a single enemy", "detector": "DebuffStacks", "tags": ["debuffs"],
      "tiers": [ { "difficulty": 1, "params": { "n": 5 } }, { "difficulty": 2, "params": { "n": 10 } }, { "difficulty": 3, "params": { "n": 20 } }, { "difficulty": 4, "params": { "n": 35 } } ] },
    { "id": "buff_variety", "text": "Have {n}+ different buffs at once", "detector": "BuffVariety", "tags": ["buffs"],
      "tiers": [ { "difficulty": 1, "params": { "n": 3 } }, { "difficulty": 2, "params": { "n": 5 } }, { "difficulty": 3, "params": { "n": 7 } }, { "difficulty": 4, "params": { "n": 9 } } ] },
    { "id": "buff_stacks", "text": "Have {n}+ stacks of one buff", "detector": "BuffStacks", "tags": ["buffs"],
      "tiers": [ { "difficulty": 1, "params": { "n": 5 } }, { "difficulty": 2, "params": { "n": 10 } }, { "difficulty": 3, "params": { "n": 20 } }, { "difficulty": 4, "params": { "n": 30 } } ] },

    // ---- Items, shops and rest sites ------------------------------------------------------
    { "id": "potions_in_combat", "text": "Use {n}+ potions in a single fight", "detector": "PotionsInCombat", "tags": ["potions"],
      "tiers": [ { "difficulty": 2, "params": { "n": 2 } }, { "difficulty": 3, "params": { "n": 3 } }, { "difficulty": 4, "params": { "n": 4 } } ] },
    { "id": "potions_used", "text": "Use {n} potions", "detector": "PotionsUsed", "tags": ["potions"],
      "tiers": [ { "difficulty": 1, "params": { "n": 5 } }, { "difficulty": 2, "params": { "n": 8 } }, { "difficulty": 3, "params": { "n": 12 } } ] },
    { "id": "shop_spree", "text": "Buy {n}+ items in a single shop visit", "detector": "ShopItemsInVisit", "tags": ["shop"],
      "tiers": [ { "difficulty": 1, "params": { "n": 2 } }, { "difficulty": 2, "params": { "n": 3 } }, { "difficulty": 3, "params": { "n": 5 } } ] },
    { "id": "relics_bought", "text": "Buy {n} relics from shops", "detector": "RelicsBought", "tags": ["shop"],
      "tiers": [ { "difficulty": 2, "params": { "n": 2 } }, { "difficulty": 3, "params": { "n": 3 } }, { "difficulty": 4, "params": { "n": 4 } } ] },
    { "id": "card_removals", "text": "Remove {n} cards at shops", "detector": "CardsRemovedAtShop", "tags": ["shop"],
      "tiers": [ { "difficulty": 1, "params": { "n": 1 } }, { "difficulty": 3, "params": { "n": 2 } }, { "difficulty": 4, "params": { "n": 3 } } ] },
    { "id": "gold_held", "text": "Have {n}+ gold at once", "detector": "GoldHeld", "tags": ["gold"],
      "tiers": [ { "difficulty": 1, "params": { "n": 250 } }, { "difficulty": 2, "params": { "n": 400 } }, { "difficulty": 3, "params": { "n": 600 } }, { "difficulty": 4, "params": { "n": 900 } } ] },
    { "id": "rest_smiths", "text": "Upgrade a card at {n} rest sites", "detector": "RestSmiths", "tags": ["rest"],
      "tiers": [ { "difficulty": 1, "params": { "n": 2 } }, { "difficulty": 2, "params": { "n": 4 } }, { "difficulty": 3, "params": { "n": 6 } } ] },
    { "id": "rest_heals", "text": "Rest at {n} rest sites", "detector": "RestHeals", "tags": ["rest"],
      "tiers": [ { "difficulty": 1, "params": { "n": 2 } }, { "difficulty": 2, "params": { "n": 3 } }, { "difficulty": 3, "params": { "n": 5 } } ] },

    // ---- Character goals (only when every player is that character, or anyone in Team) -----
    { "id": "ironclad_strength", "text": "Have {n}+ Strength", "detector": "StrengthStacks", "tags": ["buffs"], "exclusions": ["buff_stacks"],
      "requires": { "character": "IRONCLAD" },
      "tiers": [ { "difficulty": 1, "params": { "n": 5 } }, { "difficulty": 2, "params": { "n": 8 } }, { "difficulty": 3, "params": { "n": 15 } }, { "difficulty": 4, "params": { "n": 25 } } ] },
    { "id": "silent_poison", "text": "Put {n}+ Poison on a single enemy", "detector": "PoisonStacks", "tags": ["debuffs"], "exclusions": ["debuff_stacks"],
      "requires": { "character": "SILENT" },
      "tiers": [ { "difficulty": 1, "params": { "n": 15 } }, { "difficulty": 2, "params": { "n": 30 } }, { "difficulty": 3, "params": { "n": 50 } }, { "difficulty": 4, "params": { "n": 80 } } ] },
    { "id": "defect_orbs", "text": "Channel {n}+ orbs in a single fight", "detector": "OrbsInCombat", "tags": ["orbs"],
      "requires": { "character": "DEFECT" },
      "tiers": [ { "difficulty": 1, "params": { "n": 6 } }, { "difficulty": 2, "params": { "n": 10 } }, { "difficulty": 3, "params": { "n": 15 } } ] },
    { "id": "necrobinder_pet_damage", "text": "Have your pet deal {n}+ damage in a single fight", "detector": "PetDamageInCombat", "tags": ["pet"],
      "requires": { "character": "NECROBINDER" },
      "tiers": [ { "difficulty": 1, "params": { "n": 20 } }, { "difficulty": 2, "params": { "n": 40 } }, { "difficulty": 3, "params": { "n": 80 } } ] },
    { "id": "regent_stars", "text": "Spend {n}+ stars in a single turn", "detector": "StarsInTurn", "tags": ["stars"],
      "requires": { "character": "REGENT" },
      "tiers": [ { "difficulty": 1, "params": { "n": 3 } }, { "difficulty": 2, "params": { "n": 5 } }, { "difficulty": 3, "params": { "n": 8 } } ] }
  ]
}
